<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#101820">
    <LinearLayout android:layout_width="match_parent" android:layout_height="60dp" android:paddingStart="16dp" android:paddingEnd="16dp" android:gravity="center_vertical" android:background="#182431">
        <TextView android:id="@+id/title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="AlienGram" android:textColor="#F3F6FA" android:textSize="22sp" android:textStyle="bold"/>
        <TextView android:id="@+id/wallet" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⭐ 0" android:textColor="#F5C95D" android:textSize="15sp" android:padding="8dp"/>
        <TextView android:id="@+id/admin" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⋮" android:textColor="#E8EEF5" android:textSize="26sp" android:padding="8dp"/>
    </LinearLayout>
    <EditText android:id="@+id/search" android:layout_width="match_parent" android:layout_height="48dp" android:layout_margin="12dp" android:paddingStart="14dp" android:paddingEnd="14dp" android:hint="Search" android:textColor="#F2F5F8" android:textColorHint="#8394A5" android:background="#202D3A" android:singleLine="true"/>
    <TextView android:layout_width="match_parent" android:layout_height="42dp" android:paddingStart="16dp" android:gravity="center_vertical" android:text="CHATS" android:textColor="#8E9EAF" android:textSize="12sp" android:textStyle="bold"/>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:id="@+id/chatList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:gravity="center" android:background="#182431">
        <TextView android:id="@+id/navChats" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="💬 Chats" android:textColor="#879AFF" android:textSize="14sp"/>
        <TextView android:id="@+id/navContacts" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="👥 Contacts" android:textColor="#8E9EAF" android:textSize="14sp"/>
        <TextView android:id="@+id/navSettings" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="⚙ Settings" android:textColor="#8E9EAF" android:textSize="14sp"/>
    </LinearLayout>
</LinearLayout>
